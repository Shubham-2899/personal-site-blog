# Absolute origin — used for canonical URLs, OG tags, sitemap and RSS.
# Set this in Vercel for production; local dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form. Get a key at https://resend.com/api-keys
# Without it, /api/contact returns 503 and the form tells visitors to email instead.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend.
# Leave unset to use Resend's onboarding@resend.dev while testing.
CONTACT_FROM_EMAIL=
